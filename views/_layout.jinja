<!DOCTYPE html>
<html lang="{{ locale|default("en", true)|e }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ msg["app.title"]|e }} - {{ msg["app.subtitle"]|e }}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="/resources/css/petclinic.css" rel="stylesheet">
{% block head %}{% endblock %}
</head>
<body class="d-flex flex-column min-vh-100">
<nav class="navbar navbar-expand-lg">
    <div class="container">
        <a class="navbar-brand" href="/">
            <i class="fas fa-paw"></i>
            <span>{{ msg["app.title"]|e }}</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="/">
                        <i class="fas fa-home"></i> {{ msg["nav.home"]|e }}
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/owners/find">
                        <i class="fas fa-search"></i> {{ msg["nav.findOwners"]|e }}
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/vets">
                        <i class="fas fa-user-md"></i> {{ msg["nav.veterinarians"]|e }}
                    </a>
                </li>
                {% if oracleEnabled %}
                    <li class="nav-item">
                        <a class="nav-link" href="/visits">
                            <i class="fas fa-calendar-check"></i> {{ msg["nav.visits"]|e }}
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/oracle/transaction-priority">
                            <i class="fas fa-bolt"></i> {{ msg["nav.transactionPriority"]|e }}
                        </a>
                    </li>
                {% endif %}

                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="languageDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-globe"></i>
                        {% if locale[:2] == "en" %}
                            {{ msg["lang.en"]|e }}
                        {% endif %}
                        {% if locale[:2] == "es" %}
                            {{ msg["lang.es"]|e }}
                        {% endif %}
                        {% if locale[:2] == "de" %}
                            {{ msg["lang.de"]|e }}
                        {% endif %}
                        {% if not locale %}
                            {{ msg["lang.en"]|e }}
                        {% endif %}
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="languageDropdown">
                        <li><a class="dropdown-item" href="/locale?lang=en&backUrl={{ requestPath|e }}">{{ msg["lang.en"]|e }}</a></li>
                        <li><a class="dropdown-item" href="/locale?lang=es&backUrl={{ requestPath|e }}">{{ msg["lang.es"]|e }}</a></li>
                        <li><a class="dropdown-item" href="/locale?lang=de&backUrl={{ requestPath|e }}">{{ msg["lang.de"]|e }}</a></li>
                    </ul>
                </li>
            </ul>
        </div>
    </div>
</nav>

<main class="flex-grow-1 py-4">
    {% block content %}{% endblock %}
</main>

<footer class="footer">
    <div class="container">
        <div class="row">
            <div class="col-md-4 mb-4 mb-md-0">
                <h5><i class="fas fa-paw me-2"></i>{{ msg["footer.about"]|e }}</h5>
                <p class="mb-0">{{ msg["footer.description"]|e }}</p>
            </div>
            <div class="col-md-4 mb-4 mb-md-0">
                <h5>{{ msg["footer.quickLinks"]|e }}</h5>
                <ul class="list-unstyled mb-0">
                    <li><a href="/"><i class="fas fa-chevron-right me-2"></i>{{ msg["nav.home"]|e }}</a></li>
                    <li><a href="/owners/find"><i class="fas fa-chevron-right me-2"></i>{{ msg["nav.findOwners"]|e }}</a></li>
                    <li><a href="/vets"><i class="fas fa-chevron-right me-2"></i>{{ msg["nav.veterinarians"]|e }}</a></li>
                </ul>
            </div>
            <div class="col-md-4">
                <h5>{{ msg["footer.poweredBy"]|e }}</h5>
                <p class="mb-2">
                    <a href="https://micronaut.io" target="_blank" rel="noopener noreferrer">
                        <i class="fas fa-bolt me-2"></i>{{ msg["footer.micronautFramework"]|e }}
                    </a>
                </p>
                <p class="mb-0">
                    <a href="https://github.com/micronaut-projects/micronaut-petclinic" target="_blank" rel="noopener noreferrer">
                        <i class="fab fa-github me-2"></i>{{ msg["footer.viewOnGitHub"]|e }}
                    </a>
                </p>
            </div>
        </div>
        <div class="footer-bottom text-center">
            <p class="mb-0">{{ msg["footer.copyright"]|e }}</p>
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
{% block scripts %}{% endblock %}
</body>
</html>
