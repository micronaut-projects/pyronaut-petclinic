<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pet Clinic - Modern Pet Care Management</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="/resources/css/petclinic.css" rel="stylesheet">
</head>
<body class="d-flex flex-column min-vh-100">
<nav class="navbar navbar-expand-lg">
    <div class="container">
        <a class="navbar-brand" href="/">
            <i class="fas fa-paw"></i>
            <span>Pet Clinic</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                        <a class="nav-link" href="/">
                        <i class="fas fa-home"></i> Home
                    </a>
                </li>
                <li class="nav-item">
                        <a class="nav-link" href="/owners/find">
                        <i class="fas fa-search"></i> Find Owners
                    </a>
                </li>
                <li class="nav-item">
                        <a class="nav-link" href="/vets">
                        <i class="fas fa-user-md"></i> Veterinarians
                    </a>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="languageDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-globe"></i>
                        English
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="languageDropdown">
                        <li><a class="dropdown-item" href="/locale?lang=en&backUrl=/">English</a></li>
                        <li><a class="dropdown-item" href="/locale?lang=es&backUrl=/">Español</a></li>
                        <li><a class="dropdown-item" href="/locale?lang=de&backUrl=/">Deutsch</a></li>
                    </ul>
                </li>
            </ul>
        </div>
    </div>
</nav>

<main class="flex-grow-1 py-4">
{% block content %}{% endblock %}
</main>

<footer class="footer">
    <div class="container">
        <div class="row">
            <div class="col-md-4 mb-4 mb-md-0">
                <h5><i class="fas fa-paw me-2"></i>PetClinic</h5>
                <p class="mb-0">Modern pet care management system built with Micronaut Framework.</p>
            </div>
            <div class="col-md-4 mb-4 mb-md-0">
                <h5>Quick Links</h5>
                <ul class="list-unstyled mb-0">
                    <li><a href="/"><i class="fas fa-chevron-right me-2"></i>Home</a></li>
                    <li><a href="/owners/find"><i class="fas fa-chevron-right me-2"></i>Find Owners</a></li>
                    <li><a href="/vets"><i class="fas fa-chevron-right me-2"></i>Veterinarians</a></li>
                </ul>
            </div>
            <div class="col-md-4">
                <h5>Powered By</h5>
                <p class="mb-2">
                    <a href="https://micronaut.io" target="_blank" rel="noopener noreferrer">
                        <i class="fas fa-bolt me-2"></i>Micronaut Framework
                    </a>
                </p>
                <p class="mb-0">
                    <a href="https://github.com/micronaut-projects/micronaut-petclinic" target="_blank" rel="noopener noreferrer">
                        <i class="fab fa-github me-2"></i>View on GitHub
                    </a>
                </p>
            </div>
        </div>
        <div class="footer-bottom text-center">
            <p class="mb-0">© 2025 PetClinic. Built with ❤ using Micronaut</p>
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
