{% extends "_layout.jinja" %}
{% block content %}
{% if error %}<main class="container py-5"><div class="alert alert-warning">{{ error|e }}</div></main>{% else %}
<div class="page-header"><div class="container"><h1><i class="fas fa-calendar-plus me-3"></i>New Visit</h1><p>Name: {{ pet.name|e }}</p></div></div><main class="container flex-grow-1 py-4"><a href="/owners/{{ owner.id }}" class="btn btn-secondary mb-4">Back to Owner</a><div class="form-container"><form action="/owners/{{ owner.id }}/pets/{{ pet.id }}/visits/new" method="post"><label for="date" class="form-label">Visit Date</label><input type="date" class="form-control {% if validationErrors.date %}is-invalid{% endif %}" id="date" name="date" value="{{ visit.date|default('', true)|e }}" required><div class="invalid-feedback">{{ validationErrors.date|default('Visit date is required.', true)|e }}</div><label for="description" class="form-label mt-3">Description</label><textarea class="form-control {% if validationErrors.description %}is-invalid{% endif %}" id="description" name="description" rows="4" required>{{ visit.description|default('', true)|e }}</textarea><div class="invalid-feedback">{{ validationErrors.description|default('Description is required.', true)|e }}</div><button type="submit" class="btn btn-primary mt-4">Add Visit</button></form></div></main>{% endif %}
{% endblock %}
