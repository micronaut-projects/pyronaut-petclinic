{% extends "_layout.jinja" %}
{% block content %}

    <div class="page-header">
        <div class="container">
            <h1>
                <i class="{{ ("fas fa-plus-circle me-3" if isNew else "fas fa-edit me-3")|e }}"></i>
                {{ (msg["pet.new"] if isNew else msg["pet.editPet"])|e }}
            </h1>
            {% if owner != none %}
                <p>
                    <i class="fas fa-user me-2"></i>{{ msg["pet.owner"]|e }}: {{ owner.firstName|e }} {{ owner.lastName|e }}
                </p>
            {% endif %}
        </div>
    </div>

    <main class="container flex-grow-1 py-4">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <a href="/owners/{{ owner.id|e }}" class="btn btn-secondary mb-4">
                    <i class="fas fa-arrow-left me-2"></i>{{ msg["pet.backToOwner"]|e }}
                </a>

                <div class="form-container animate-fade-in-up">
                    <div class="text-center mb-4">
                        <div class="feature-icon gradient-2 mx-auto mb-3">
                            <i class="fas fa-paw"></i>
                        </div>
                        <h4>{{ (msg["pet.registerNew"] if isNew else msg["pet.updateInfo"])|e }}</h4>
                    </div>

                    {% if validationErrors != none and not (not validationErrors) %}
                        <div class="alert alert-danger" role="alert">
                            {{ msg["validation.fixErrors"]|e }}
                        </div>
                    {% endif %}

                    <form action="{{ ("/owners/" ~ owner.id ~ "/pets/new" if isNew else "/owners/" ~ owner.id ~ "/pets/" ~ pet.id ~ "/edit")|e }}" method="post" class="needs-validation" novalidate>
                        <div class="mb-4">
                            <label for="name" class="form-label">
                                <i class="fas fa-tag me-2 text-primary"></i>{{ msg["pet.name"]|e }}
                            </label>
                            <input type="text" class="form-control {{ ("is-invalid" if validationErrors != none and validationErrors["name"] else "")|e }}" id="name" name="name"
                                   value="{{ (pet.name if pet != none and pet.name != none else "")|e }}" required>
                            {% if validationErrors != none and validationErrors["name"] %}
                                <div class="invalid-feedback">{{ validationErrors["name"]|e }}</div>
                            {% else %}
                                <div class="invalid-feedback">{{ msg["validation.petName.required"]|e }}</div>
                            {% endif %}
                        </div>

                        <div class="mb-4">
                            <label for="birthDate" class="form-label">
                                <i class="fas fa-birthday-cake me-2 text-primary"></i>{{ msg["pet.birthDate"]|e }}
                            </label>
                            <input type="date" class="form-control {{ ("is-invalid" if validationErrors != none and validationErrors["birthDate"] else "")|e }}" id="birthDate" name="birthDate"
                                   value="{{ (pet.birthDate if pet != none and pet.birthDate != none else "")|e }}" required>
                            {% if validationErrors != none and validationErrors["birthDate"] %}
                                <div class="invalid-feedback">{{ validationErrors["birthDate"]|e }}</div>
                            {% else %}
                                <div class="invalid-feedback">{{ msg["validation.birthDate.required"]|e }}</div>
                            {% endif %}
                        </div>

                        <div class="mb-4">
                            <label for="typeId" class="form-label">
                                <i class="fas fa-paw me-2 text-primary"></i>{{ msg["pet.type"]|e }}
                            </label>
                            <select class="form-select {{ ("is-invalid" if validationErrors != none and validationErrors["typeId"] else "")|e }}" id="typeId" name="typeId" required>
                                <option value="">{{ msg["pet.selectType"]|e }}</option>
                                {% for type in types %}
                                    {% if pet != none and pet.typeId != none and (pet.typeId|string) == (type.id|string) %}
                                        <option value="{{ type.id|e }}" selected>{{ type.name|e }}</option>
                                    {% else %}
                                        <option value="{{ type.id|e }}">{{ type.name|e }}</option>
                                    {% endif %}
                                {% endfor %}
                            </select>
                            {% if validationErrors != none and validationErrors["typeId"] %}
                                <div class="invalid-feedback">{{ validationErrors["typeId"]|e }}</div>
                            {% else %}
                                <div class="invalid-feedback">{{ msg["validation.petType.required"]|e }}</div>
                            {% endif %}
                        </div>

                        <hr class="my-4">

                        <div class="d-flex gap-3">
                            <button type="submit" class="btn btn-primary btn-lg flex-grow-1">
                                <i class="{{ ("fas fa-plus me-2" if isNew else "fas fa-save me-2")|e }}"></i>
                                {{ (msg["button.addPet"] if isNew else msg["button.update"])|e }}
                            </button>
                            <a href="/owners/{{ owner.id|e }}" class="btn btn-secondary btn-lg">
                                <i class="fas fa-times me-2"></i>{{ msg["button.cancel"]|e }}
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>
{% endblock %}
