{% extends "_layout.jinja" %}
{% block content %}
{% if error %}
<main class="container py-5"><div class="alert alert-warning">{{ error|e }}</div></main>
{% else %}
{% set editing = not isNew %}
<div class="page-header"><div class="container"><h1><i class="fas fa-paw me-3"></i>{% if editing %}Edit Pet{% else %}New Pet{% endif %}</h1><p>Owner: {{ owner.firstName|e }} {{ owner.lastName|e }}</p></div></div>
<main class="container flex-grow-1 py-4"><div class="form-container"><form action="{% if editing %}/owners/{{ owner.id }}/pets/{{ petId }}/edit{% else %}/owners/{{ owner.id }}/pets/new{% endif %}" method="post">
<label for="name" class="form-label">Name</label><input class="form-control {% if validationErrors.name %}is-invalid{% endif %}" id="name" name="name" value="{{ pet.name|default('', true)|e }}" required><div class="invalid-feedback">{{ validationErrors.name|default('Pet name is required.', true)|e }}</div>
<label for="birthDate" class="form-label mt-3">Birth Date</label><input type="date" class="form-control {% if validationErrors.birthDate %}is-invalid{% endif %}" id="birthDate" name="birthDate" value="{{ pet.birthDate|default('', true)|e }}" required><div class="invalid-feedback">{{ validationErrors.birthDate|default('Birth date is required.', true)|e }}</div>
<label for="typeId" class="form-label mt-3">Type</label><select class="form-select {% if validationErrors.typeId %}is-invalid{% endif %}" id="typeId" name="typeId" required><option value="">Select a type...</option>
{% for type in types %}<option value="{{ type.id }}"{% if pet.typeId|default('', true)|string == type.id|string %} selected{% endif %}>{{ type.name|e }}</option>{% endfor %}
</select><div class="invalid-feedback">{{ validationErrors.typeId|default('Pet type is required', true)|e }}</div><div class="d-flex gap-3 mt-4"><button type="submit" class="btn btn-primary flex-grow-1">{% if editing %}Update{% else %}Add Pet{% endif %}</button><a href="/owners/{{ owner.id }}" class="btn btn-secondary">Cancel</a></div></form></div></main>
{% endif %}
{% endblock %}
