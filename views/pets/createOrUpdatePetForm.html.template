<div class="page-header">
    <div class="container">
        <h1><i class="$header_icon"></i>$header_title</h1>
        <p>$form_description</p>
    </div>
</div>

<main class="container flex-grow-1 py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <a href="$back_url" class="btn btn-secondary mb-4">
                <i class="fas fa-arrow-left me-2"></i>Back to Owner
            </a>

            <div class="form-container animate-fade-in-up">
                <div class="text-center mb-4">
                    <div class="feature-icon gradient-2 mx-auto mb-3">
                        <i class="fas fa-paw"></i>
                    </div>
                    <h4>$pet_form_title</h4>
                    <p class="text-muted">$pet_form_subtitle</p>
                </div>

                $type_error
                $validation_summary

                <form action="$form_action" method="post" class="needs-validation" novalidate>
                    <div class="mb-4">
                        <label for="name" class="form-label">
                            <i class="fas fa-paw me-2 text-primary"></i>Name
                        </label>
                        <input type="text" class="form-control $name_invalid" id="name" name="name" value="$pet_name" required>
                        <div class="invalid-feedback">$name_error</div>
                    </div>

                    <div class="mb-4">
                        <label for="birthDate" class="form-label">
                            <i class="fas fa-calendar me-2 text-primary"></i>Birth Date
                        </label>
                        <input type="date" class="form-control $birth_invalid" id="birthDate" name="birthDate" value="$birth_date" required>
                        <div class="invalid-feedback">$birth_error</div>
                    </div>

                    <div class="mb-4">
                        <label for="typeId" class="form-label">
                            <i class="fas fa-paw me-2 text-primary"></i>Type
                        </label>
                        <select class="form-select $type_invalid" id="typeId" name="typeId" required>
                            <option value="">Select a type...</option>
$type_options
                        </select>
                        <div class="invalid-feedback">$type_feedback</div>
                    </div>

                    <hr class="my-4">

                    <div class="d-flex gap-3">
                        <button type="submit" class="btn btn-primary btn-lg flex-grow-1">
                            <i class="$button_icon"></i>
                            $button_label
                        </button>
                        <a href="$back_url" class="btn btn-secondary btn-lg">
                            <i class="fas fa-times me-2"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</main>
