<div class="detail-card animate-fade-in-up">
    <div class="card-header">
        <h5 class="mb-0"><i class="fas fa-paw me-2"></i>Pet Information</h5>
    </div>
    <div class="detail-body">
        <div class="text-center mb-4">
            {{ pet_icon }}
            <h5>{{ pet_name }}</h5>
        </div>
        <div class="info-row">
            <div class="info-label">Type</div>
            <div class="info-value">{{ pet_type }}</div>
        </div>
        <div class="info-row">
            <div class="info-label">Birth Date</div>
            <div class="info-value">{{ birth_date }}</div>
        </div>
        <div class="info-row">
            <div class="info-label">Owner</div>
            <div class="info-value">{{ owner_name }}</div>
        </div>
    </div>
</div>
{{ previous_visits }}
