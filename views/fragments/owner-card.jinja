<div class="col-md-6 col-lg-4">
    <div class="owner-card animate-fade-in-up">
        <div class="d-flex align-items-start mb-3">
            <div class="owner-avatar me-3">
                <span>{{ initials }}</span>
            </div>
            <div class="flex-grow-1">
                <h5 class="mb-1">
                    <a href="/owners/{{ owner_id }}" class="text-decoration-none text-dark">
                        {{ first_name }} {{ last_name }}
                    </a>
                </h5>
                <p class="text-muted mb-0 small">
                    <i class="fas fa-map-marker-alt me-1"></i>{{ city }}
                </p>
            </div>
        </div>

        <div class="mb-3">
            <p class="mb-1 small text-muted">
                <i class="fas fa-home me-2"></i>{{ address }}
            </p>
            <p class="mb-0 small text-muted">
                <i class="fas fa-phone me-2"></i>{{ telephone }}
            </p>
        </div>

        <div class="mb-3">
            <div class="d-flex flex-wrap">
                {{ pets_html }}
            </div>
        </div>

        <a href="/owners/{{ owner_id }}" class="btn btn-primary btn-sm w-100">
            <i class="fas fa-eye me-2"></i>View Details
        </a>
    </div>
</div>
