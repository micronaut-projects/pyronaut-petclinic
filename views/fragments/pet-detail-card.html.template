<div class="pet-card mb-3">
    <div class="row align-items-center">
        <div class="col-md-4">
            <div class="d-flex align-items-center">
                $pet_icon
                <div>
                    <h6 class="mb-0">$pet_name</h6>
                    <small class="text-muted">$pet_type</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <small class="text-muted d-block">Birth Date</small>
            <span>$birth_date</span>
        </div>
        <div class="col-md-5 text-md-end mt-3 mt-md-0">
            <a href="/owners/$owner_id/pets/$pet_id/edit" class="btn btn-sm btn-outline-primary me-2">
                <i class="fas fa-edit"></i> Edit
            </a>
            <a href="/owners/$owner_id/pets/$pet_id/visits/new" class="btn btn-sm btn-primary">
                <i class="fas fa-plus"></i> Add Visit
            </a>
        </div>
    </div>
    $visits
</div>
