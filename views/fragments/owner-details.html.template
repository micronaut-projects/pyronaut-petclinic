<div class="page-header">
    <div class="container">
        <div class="d-flex align-items-center">
            <div class="detail-avatar me-4">
                <span>$initials</span>
            </div>
            <div>
                <h1>$first_name $last_name</h1>
                <p class="mb-0"><i class="fas fa-map-marker-alt me-2"></i>$city</p>
            </div>
        </div>
    </div>
</div>

<main class="container flex-grow-1 py-4">
    <a href="/owners/find" class="btn btn-secondary mb-4">
        <i class="fas fa-arrow-left me-2"></i>Back to Search
    </a>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="detail-card animate-fade-in-up">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-user me-2"></i>Owner Information</h5>
                </div>
                <div class="detail-body">
                    <div class="info-row">
                        <div class="info-label"><i class="fas fa-user me-2"></i>Name</div>
                        <div class="info-value">$first_name $last_name</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label"><i class="fas fa-home me-2"></i>Address</div>
                        <div class="info-value">$address</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label"><i class="fas fa-city me-2"></i>City</div>
                        <div class="info-value">$city</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label"><i class="fas fa-phone me-2"></i>Phone</div>
                        <div class="info-value">$telephone</div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <a href="/owners/$owner_id/edit" class="btn btn-primary flex-grow-1">
                            <i class="fas fa-edit me-2"></i>Edit
                        </a>
                        <a href="/owners/$owner_id/pets/new" class="btn btn-success flex-grow-1">
                            <i class="fas fa-plus me-2"></i>Add Pet
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="card animate-fade-in-up stagger-1">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-paw me-2"></i>Pets & Visits</h5>
                    <span class="badge bg-white text-primary">$pet_count pets</span>
                </div>
                <div class="card-body">
                    $pets_block
                </div>
            </div>
        </div>
    </div>
</main>
