{% extends "_layout.jinja" %}
{% block content %}
{% set editing = not isNew %}{% set owner_id = ownerId|default(owner.id, true) %}
<div class="page-header"><div class="container"><h1><i class="fas fa-user me-3"></i>{% if editing %}Edit Owner{% else %}New Owner{% endif %}</h1><p>{% if editing %}Update owner information{% else %}Register a new pet owner{% endif %}</p></div></div>
<main class="container flex-grow-1 py-4"><div class="form-container"><form action="{% if editing %}/owners/{{ owner_id }}/edit{% else %}/owners/new{% endif %}" method="post"><div class="row g-4"><div class="col-md-6"><label for="firstName" class="form-label">First Name</label><input class="form-control {% if validationErrors.firstName %}is-invalid{% endif %}" id="firstName" name="firstName" value="{{ owner.firstName|default('', true)|e }}" required><div class="invalid-feedback">{{ validationErrors.firstName|default('First name is required.', true)|e }}</div></div><div class="col-md-6"><label for="lastName" class="form-label">Last Name</label><input class="form-control {% if validationErrors.lastName %}is-invalid{% endif %}" id="lastName" name="lastName" value="{{ owner.lastName|default('', true)|e }}" required><div class="invalid-feedback">{{ validationErrors.lastName|default('Last name is required.', true)|e }}</div></div><div class="col-md-6"><label for="address" class="form-label">Address</label><input class="form-control {% if validationErrors.address %}is-invalid{% endif %}" id="address" name="address" value="{{ owner.address|default('', true)|e }}" required><div class="invalid-feedback">{{ validationErrors.address|default('Address is required.', true)|e }}</div></div><div class="col-md-6"><label for="city" class="form-label">City</label><input class="form-control {% if validationErrors.city %}is-invalid{% endif %}" id="city" name="city" value="{{ owner.city|default('', true)|e }}" required><div class="invalid-feedback">{{ validationErrors.city|default('City is required.', true)|e }}</div></div><div class="col-md-6"><label for="telephone" class="form-label">Telephone</label><input class="form-control {% if validationErrors.telephone %}is-invalid{% endif %}" id="telephone" name="telephone" value="{{ owner.telephone|default('', true)|e }}" required><div class="invalid-feedback">{{ validationErrors.telephone|default('Please enter a valid telephone number (10 digits)', true)|e }}</div></div></div><div class="d-flex gap-3 mt-4"><button type="submit" class="btn btn-primary flex-grow-1">{% if editing %}Update Owner{% else %}Add Owner{% endif %}</button><a href="{% if editing %}/owners/{{ owner_id }}{% else %}/owners/find{% endif %}" class="btn btn-secondary">Cancel</a></div></form></div></main>
{% endblock %}
