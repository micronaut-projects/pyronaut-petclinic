{% extends "_layout.jinja" %}
{% block content %}

    <div class="page-header">
        <div class="container">
            <h1>
                <i class="{{ ("fas fa-user-plus me-3" if isNew else "fas fa-user-edit me-3")|e }}"></i>
                {{ (msg["owner.new"] if isNew else msg["owner.editOwner"])|e }}
            </h1>
            <p>{{ (msg["form.newOwner.desc"] if isNew else msg["form.editOwner.desc"])|e }}</p>
        </div>
    </div>

    <main class="container flex-grow-1 py-4">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <a href="{{ ("/owners/find" if isNew else "/owners/" ~ owner.id)|e }}" class="btn btn-secondary mb-4">
                    <i class="fas fa-arrow-left me-2"></i>{{ msg["button.back"]|e }}
                </a>

                <div class="form-container animate-fade-in-up">
                    {% if validationErrors != none and not (not validationErrors) %}
                        <div class="alert alert-danger" role="alert">
                            {{ msg["validation.fixErrors"]|e }}
                        </div>
                    {% endif %}
                    <form action="{{ ("/owners/new" if isNew else "/owners/" ~ owner.id ~ "/edit")|e }}" method="post" class="needs-validation" novalidate>
                        <div class="row mb-4">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <label for="firstName" class="form-label">
                                    <i class="fas fa-user me-2 text-primary"></i>{{ msg["owner.firstName"]|e }}
                                </label>
                                <input type="text" class="form-control {{ ("is-invalid" if validationErrors != none and validationErrors["firstName"] else "")|e }}" id="firstName" name="firstName"
                                       value="{{ (owner.firstName if owner != none and owner.firstName != none else "")|e }}" required>
                                <div class="invalid-feedback">{{ (validationErrors["firstName"] if validationErrors != none and validationErrors["firstName"] else msg["validation.firstName.required"])|e }}</div>
                            </div>
                            <div class="col-md-6">
                                <label for="lastName" class="form-label">
                                    <i class="fas fa-user me-2 text-primary"></i>{{ msg["owner.lastName"]|e }}
                                </label>
                                <input type="text" class="form-control {{ ("is-invalid" if validationErrors != none and validationErrors["lastName"] else "")|e }}" id="lastName" name="lastName"
                                       value="{{ (owner.lastName if owner != none and owner.lastName != none else "")|e }}" required>
                                <div class="invalid-feedback">{{ (validationErrors["lastName"] if validationErrors != none and validationErrors["lastName"] else msg["validation.lastName.required"])|e }}</div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="address" class="form-label">
                                <i class="fas fa-home me-2 text-primary"></i>{{ msg["owner.address"]|e }}
                            </label>
                            <input type="text" class="form-control {{ ("is-invalid" if validationErrors != none and validationErrors["address"] else "")|e }}" id="address" name="address"
                                   value="{{ (owner.address if owner != none and owner.address != none else "")|e }}" required>
                            <div class="invalid-feedback">{{ (validationErrors["address"] if validationErrors != none and validationErrors["address"] else msg["validation.address.required"])|e }}</div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <label for="city" class="form-label">
                                    <i class="fas fa-city me-2 text-primary"></i>{{ msg["owner.city"]|e }}
                                </label>
                                <input type="text" class="form-control {{ ("is-invalid" if validationErrors != none and validationErrors["city"] else "")|e }}" id="city" name="city"
                                       value="{{ (owner.city if owner != none and owner.city != none else "")|e }}" required>
                                <div class="invalid-feedback">{{ (validationErrors["city"] if validationErrors != none and validationErrors["city"] else msg["validation.city.required"])|e }}</div>
                            </div>
                            <div class="col-md-6">
                                <label for="telephone" class="form-label">
                                    <i class="fas fa-phone me-2 text-primary"></i>{{ msg["owner.telephone"]|e }}
                                </label>
                                <input type="tel" class="form-control {{ ("is-invalid" if validationErrors != none and validationErrors["telephone"] else "")|e }}" id="telephone" name="telephone"
                                       value="{{ (owner.telephone if owner != none and owner.telephone != none else "")|e }}" pattern="[0-9]{10}" required>
                                <div class="invalid-feedback">{{ (validationErrors["telephone"] if validationErrors != none and validationErrors["telephone"] else msg["validation.telephone"])|e }}</div>
                            </div>
                        </div>

                        <hr class="my-4">

                        <div class="d-flex gap-3">
                            <button type="submit" class="btn btn-primary btn-lg flex-grow-1">
                                <i class="{{ ("fas fa-plus me-2" if isNew else "fas fa-save me-2")|e }}"></i>
                                {{ (msg["button.addOwner"] if isNew else msg["button.updateOwner"])|e }}
                            </button>
                            <a href="{{ ("/owners/find" if isNew else "/owners/" ~ owner.id)|e }}" class="btn btn-secondary btn-lg">
                                <i class="fas fa-times me-2"></i>{{ msg["button.cancel"]|e }}
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>
{% endblock %}
