{% extends "_layout.jinja" %}
{% block content %}

    <div class="page-header">
        <div class="container">
            <h1><i class="fas fa-users me-3"></i>{{ msg["owner.petOwners"]|e }}</h1>
            <p>{{ (msg["owner.ownersFound"]|replace("{0}", ((owners|length) if owners != none else 0)))|e }}</p>
        </div>
    </div>

    <main class="container flex-grow-1 py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <a href="/owners/find" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2"></i>{{ msg["owner.backToSearch"]|e }}
            </a>
            <a href="/owners/new" class="btn btn-success">
                <i class="fas fa-plus me-2"></i>{{ msg["search.addOwner"]|e }}
            </a>
        </div>

        {% if owners == none or (not owners) %}
            <div class="empty-state">
                <div class="empty-state-icon">
                    <i class="fas fa-users-slash"></i>
                </div>
                <h3>{{ msg["owner.noOwnersFound"]|e }}</h3>
                <p>{{ msg["owner.noOwnersMessage"]|e }}</p>
                <a href="/owners/new" class="btn btn-success">
                    <i class="fas fa-plus me-2"></i>{{ msg["owner.addNew"]|e }}
                </a>
            </div>
        {% else %}
            <div class="row g-4">
                {% for owner in owners %}
                    <div class="col-md-6 col-lg-4">
                        <div class="owner-card animate-fade-in-up">
                            <div class="d-flex align-items-start mb-3">
                                <div class="owner-avatar me-3">
                                    <span>
                                        {{ (owner.firstName[:1] if owner.firstName != none and (owner.firstName|length) > 0 else "?")|e }}
                                        {{ (owner.lastName[:1] if owner.lastName != none and (owner.lastName|length) > 0 else "?")|e }}
                                    </span>
                                </div>
                                <div class="flex-grow-1">
                                    <h5 class="mb-1">
                                        <a href="/owners/{{ owner.id|e }}" class="text-decoration-none text-dark">
                                            {{ owner.firstName|e }} {{ owner.lastName|e }}
                                        </a>
                                    </h5>
                                    <p class="text-muted mb-0 small">
                                        <i class="fas fa-map-marker-alt me-1"></i>{{ owner.city|e }}
                                    </p>
                                </div>
                            </div>

                            <div class="mb-3">
                                <p class="mb-1 small text-muted">
                                    <i class="fas fa-home me-2"></i>{{ owner.address|e }}
                                </p>
                                <p class="mb-0 small text-muted">
                                    <i class="fas fa-phone me-2"></i>{{ owner.telephone|e }}
                                </p>
                            </div>

                            {% if owner.pets != none and not (not owner.pets) %}
                                <div class="mb-3">
                                    <div class="d-flex flex-wrap">
                                        {% for pet in owner.pets %}
                                            <span class="pet-badge">
                                                <i class="fas fa-paw"></i>
                                                {{ pet.name|e }}
                                            </span>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% else %}
                                <div class="mb-3">
                                    <span class="text-muted small"><i class="fas fa-info-circle me-1"></i>{{ msg["owner.noPetsRegistered"]|e }}</span>
                                </div>
                            {% endif %}

                            <a href="/owners/{{ owner.id|e }}" class="btn btn-primary btn-sm w-100">
                                <i class="fas fa-eye me-2"></i>{{ msg["owner.viewDetails"]|e }}
                            </a>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </main>
{% endblock %}
