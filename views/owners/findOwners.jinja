{% extends "_layout.jinja" %}
{% block content %}

    <div class="page-header">
        <div class="container">
            <h1><i class="fas fa-search me-3"></i>{{ msg["owner.findOwners"]|e }}</h1>
            <p>{{ msg["search.searchOwnersByLastName"]|e }}</p>
        </div>
    </div>

    <main class="container flex-grow-1 py-4">
        <div class="search-box mb-4 animate-fade-in-up">
            <form action="/owners/list" method="get">
                <div class="row g-3 align-items-end">
                    <div class="col-md-8">
                        <label for="lastName" class="form-label">
                            <i class="fas fa-user me-2"></i>{{ msg["search.ownerLastName"]|e }}
                        </label>
                        <input type="text" class="form-control form-control-lg" id="lastName" name="lastName"
                               value="{{ (owner.lastName if owner != none else "")|e }}">
                    </div>
                    <div class="col-md-4">
                        <button class="btn btn-primary btn-lg w-100" type="submit">
                            <i class="fas fa-search me-2"></i>{{ msg["button.search"]|e }}
                        </button>
                    </div>
                </div>
            </form>
        </div>

        {% if notFound %}
            <div class="alert alert-warning animate-fade-in-up">
                <i class="fas fa-exclamation-triangle"></i>
                {{ msg["search.tryDifferent"]|e }}
            </div>
        {% endif %}

        <div class="row g-4 mt-4">
            <div class="col-md-6 animate-fade-in-up stagger-1">
                <div class="card h-100">
                    <div class="card-body d-flex align-items-center">
                        <div class="feature-icon gradient-4 me-4" style="width: 60px; height: 60px; font-size: 1.5rem;">
                            <i class="fas fa-user-plus"></i>
                        </div>
                        <div>
                            <h5 class="mb-1">{{ msg["owner.addNew"]|e }}</h5>
                            <p class="text-muted mb-2">{{ msg["form.newOwner.desc"]|e }}</p>
                            <a href="/owners/new" class="btn btn-success">
                                <i class="fas fa-plus me-2"></i>{{ msg["button.addOwner"]|e }}
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 animate-fade-in-up stagger-2">
                <div class="card h-100">
                    <div class="card-body d-flex align-items-center">
                        <div class="feature-icon gradient-1 me-4" style="width: 60px; height: 60px; font-size: 1.5rem;">
                            <i class="fas fa-list"></i>
                        </div>
                        <div>
                            <h5 class="mb-1">{{ msg["owner.viewAll"]|e }}</h5>
                            <p class="text-muted mb-2">{{ msg["owner.viewAllMessage"]|e }}</p>
                            <a href="/owners/list" class="btn btn-primary">
                                <i class="fas fa-eye me-2"></i>{{ msg["owner.viewAll"]|e }}
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mt-5 animate-fade-in-up stagger-3">
            <div class="card-body">
                <h5 class="mb-3"><i class="fas fa-lightbulb text-warning me-2"></i>{{ msg["search.tips"]|e }}</h5>
                <div class="row">
                    <div class="col-md-4">
                        <p class="mb-1"><strong>{{ msg["search.partialMatch.title"]|e }}</strong></p>
                        <p class="text-muted small">{{ msg["search.partialMatch.desc"]|e }}</p>
                    </div>
                    <div class="col-md-4">
                        <p class="mb-1"><strong>{{ msg["search.emptySearch.title"]|e }}</strong></p>
                        <p class="text-muted small">{{ msg["search.emptySearch.desc"]|e }}</p>
                    </div>
                    <div class="col-md-4">
                        <p class="mb-1"><strong>{{ msg["search.caseInsensitive.title"]|e }}</strong></p>
                        <p class="text-muted small">{{ msg["search.caseInsensitive.desc"]|e }}</p>
                    </div>
                </div>
            </div>
        </div>
    </main>
{% endblock %}
