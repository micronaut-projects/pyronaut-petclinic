<div class="page-header">
    <div class="container">
        <h1><i class="fas fa-search me-3"></i>Find Owners</h1>
        <p>Search for pet owners by last name</p>
    </div>
</div>

<main class="container flex-grow-1 py-4">
    <div class="search-box mb-4 animate-fade-in-up">
        <form action="/owners/list" method="get">
            <div class="row g-3 align-items-end">
                <div class="col-md-8">
                    <label for="lastName" class="form-label">
                        <i class="fas fa-user me-2"></i>Owner Last Name
                    </label>
                    <input type="text" class="form-control form-control-lg" id="lastName" name="lastName" value="$last_name">
                </div>
                <div class="col-md-4">
                    <button class="btn btn-primary btn-lg w-100" type="submit">
                        <i class="fas fa-search me-2"></i>Search
                    </button>
                </div>
            </div>
        </form>
    </div>

    $not_found

    <div class="row g-4 mt-4">
        <div class="col-md-6 animate-fade-in-up stagger-1">
            <div class="card h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="feature-icon gradient-4 me-4" style="width: 60px; height: 60px; font-size: 1.5rem;">
                        <i class="fas fa-user-plus"></i>
                    </div>
                    <div>
                        <h5 class="mb-1">Add New Owner</h5>
                        <p class="text-muted mb-2">Register a new pet owner</p>
                        <a href="/owners/new" class="btn btn-success">
                            <i class="fas fa-plus me-2"></i>Add Owner
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 animate-fade-in-up stagger-2">
            <div class="card h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="feature-icon gradient-1 me-4" style="width: 60px; height: 60px; font-size: 1.5rem;">
                        <i class="fas fa-list"></i>
                    </div>
                    <div>
                        <h5 class="mb-1">View All Owners</h5>
                        <p class="text-muted mb-2">Browse the complete list of pet owners</p>
                        <a href="/owners/list" class="btn btn-primary">
                            <i class="fas fa-eye me-2"></i>View All Owners
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mt-5 animate-fade-in-up stagger-3">
        <div class="card-body">
            <h5 class="mb-3"><i class="fas fa-lightbulb text-warning me-2"></i>Has not found what you were looking for?</h5>
            <div class="row">
                <div class="col-md-4">
                    <p class="mb-1"><strong>Partial Match</strong></p>
                    <p class="text-muted small">Enter partial last name to find matches (e.g., "Dav" finds "Davis")</p>
                </div>
                <div class="col-md-4">
                    <p class="mb-1"><strong>Empty Search</strong></p>
                    <p class="text-muted small">Leave the field empty and click Search to see all owners</p>
                </div>
                <div class="col-md-4">
                    <p class="mb-1"><strong>Case Insensitive</strong></p>
                    <p class="text-muted small">Search is not case sensitive - "smith" finds "Smith"</p>
                </div>
            </div>
        </div>
    </div>
</main>
