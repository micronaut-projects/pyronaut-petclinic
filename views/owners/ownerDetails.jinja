{% extends "_layout.jinja" %}
{% block content %}
{% if error %}<main class="container flex-grow-1 py-5"><div class="alert alert-warning">{{ error|e }}</div></main>
{% else %}
<div class="page-header"><div class="container"><div class="d-flex align-items-center"><div class="detail-avatar me-4"><span>{{ owner.firstName[0]|e }}{{ owner.lastName[0]|e }}</span></div><div><h1>{{ owner.firstName|e }} {{ owner.lastName|e }}</h1><p class="mb-0"><i class="fas fa-map-marker-alt me-2"></i>{{ owner.city|e }}</p></div></div></div></div>
<main class="container flex-grow-1 py-4"><a href="/owners/find" class="btn btn-secondary mb-4"><i class="fas fa-arrow-left me-2"></i>Back to Search</a><div class="row g-4"><div class="col-lg-4"><div class="detail-card animate-fade-in-up"><div class="card-header"><h5 class="mb-0"><i class="fas fa-user me-2"></i>Owner Information</h5></div><div class="detail-body"><div class="info-row"><div class="info-label">Name</div><div class="info-value">{{ owner.firstName|e }} {{ owner.lastName|e }}</div></div><div class="info-row"><div class="info-label">Address</div><div class="info-value">{{ owner.address|e }}</div></div><div class="info-row"><div class="info-label">City</div><div class="info-value">{{ owner.city|e }}</div></div><div class="info-row"><div class="info-label">Phone</div><div class="info-value">{{ owner.telephone|e }}</div></div><div class="d-flex gap-2 mt-4"><a href="/owners/{{ owner.id }}/edit" class="btn btn-primary flex-grow-1"><i class="fas fa-edit me-2"></i>Edit</a><a href="/owners/{{ owner.id }}/pets/new" class="btn btn-success flex-grow-1"><i class="fas fa-plus me-2"></i>Add Pet</a></div></div></div></div>
<div class="col-lg-8"><div class="card animate-fade-in-up stagger-1"><div class="card-header d-flex justify-content-between align-items-center"><h5 class="mb-0"><i class="fas fa-paw me-2"></i>Pets & Visits</h5><span class="badge bg-white text-primary">{{ pets|length }} pets</span></div><div class="card-body">{% for pet in pets %}<div class="pet-card mb-3"><div class="row align-items-center"><div class="col-md-4"><div class="d-flex align-items-center"><div class="pet-icon {{ pet.type|default('dog', true)|lower|e }} me-3"><i class="fas fa-paw"></i></div><div><h6 class="mb-0">{{ pet.name|e }}</h6><small class="text-muted">{{ pet.type|default('Unknown', true)|e }}</small></div></div></div><div class="col-md-3"><small class="text-muted d-block">Birth Date</small><span>{{ pet.birthDate|e }}</span></div><div class="col-md-5 text-md-end mt-3 mt-md-0"><a href="/owners/{{ owner.id }}/pets/{{ pet.id }}/edit" class="btn btn-sm btn-outline-primary me-2"><i class="fas fa-edit"></i> Edit</a><a href="/owners/{{ owner.id }}/pets/{{ pet.id }}/visits/new" class="btn btn-sm btn-primary"><i class="fas fa-plus"></i> Add Visit</a></div></div>{% if pet.visits %}<div class="mt-3 pt-3 border-top"><h6 class="text-muted mb-3"><i class="fas fa-calendar-alt me-2"></i>Visit History</h6><div class="visit-timeline">{% for visit in pet.visits %}<div class="visit-item"><div class="visit-date">{{ visit.date|e }}</div><div class="visit-description">{{ visit.description|e }}</div></div>{% endfor %}</div></div>{% endif %}</div>{% else %}<div class="text-center py-5"><h5>No Pets Yet</h5><p class="text-muted">This owner hasn't registered any pets.</p><a href="/owners/{{ owner.id }}/pets/new" class="btn btn-success"><i class="fas fa-plus me-2"></i>Add First Pet</a></div>{% endfor %}</div></div></div></div></main>
{% endif %}
{% endblock %}
