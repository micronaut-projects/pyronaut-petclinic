{% extends "_layout.jinja" %}
{% block content %}
<div class="page-header"><div class="container"><h1><i class="fas fa-user-md me-3"></i>Our Veterinarians</h1><p>Meet our team of expert veterinary professionals</p></div></div><main class="container flex-grow-1 py-4"><div class="row g-4">{% for vet in vets %}<div class="col-md-6 col-lg-4"><div class="vet-card animate-fade-in-up"><div class="vet-card-header"><div class="vet-avatar"><i class="fas fa-user-md"></i></div></div><div class="vet-card-body"><h5>{{ vet.firstName|e }} {{ vet.lastName|e }}</h5><div class="mt-3">{% for speciality in vet.specialities %}<span class="speciality-badge">{{ speciality.name|e }}</span>{% else %}<span class="speciality-badge">General Practice</span>{% endfor %}</div></div></div></div>{% else %}<div class="empty-state"><h3>No Veterinarians Found</h3></div>{% endfor %}</div></main>
{% endblock %}
