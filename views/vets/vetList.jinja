{% extends "_layout.jinja" %}
{% block content %}

    <div class="page-header">
        <div class="container">
            <h1><i class="fas fa-user-md me-3"></i>{{ msg["vet.ourVeterinarians"]|e }}</h1>
            <p>{{ msg["vet.meetTeam"]|e }}</p>
            <div class="d-flex gap-2 flex-wrap mt-3">
                <a class="btn btn-light" href="/vets/new"><i class="fas fa-plus me-1"></i>{{ msg["vet.add"]|e }}</a>
                <a class="btn btn-outline-light" href="/vets/specialities"><i class="fas fa-list me-1"></i>{{ msg["speciality.manage"]|e }}</a>
            </div>
        </div>
    </div>

    <main class="container flex-grow-1 py-4">
        {% if saved %}
            <div class="alert alert-success" role="status">{{ msg["vet.saved"]|e }}</div>
        {% endif %}
        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body d-flex align-items-center">
                        <div class="feature-icon gradient-1 me-3" style="width: 50px; height: 50px; font-size: 1.25rem;">
                            <i class="fas fa-user-md"></i>
                        </div>
                        <div>
                            <h3 class="mb-0">{{ ((vets|length) if vets != none else 0)|e }}</h3>
                            <p class="text-muted mb-0">{{ msg["vet.veterinarians"]|e }}</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body d-flex align-items-center">
                        <div class="feature-icon gradient-2 me-3" style="width: 50px; height: 50px; font-size: 1.25rem;">
                            <i class="fas fa-award"></i>
                        </div>
                        <div>
                            <h3 class="mb-0">{{ msg["vet.expert"]|e }}</h3>
                            <p class="text-muted mb-0">{{ msg["vet.careQuality"]|e }}</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body d-flex align-items-center">
                        <div class="feature-icon gradient-4 me-3" style="width: 50px; height: 50px; font-size: 1.25rem;">
                            <i class="fas fa-clock"></i>
                        </div>
                        <div>
                            <h3 class="mb-0">24/7</h3>
                            <p class="text-muted mb-0">{{ msg["vet.availability"]|e }}</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {% if vets == none  or  (not vets) %}
            <div class="empty-state">
                <div class="empty-state-icon">
                    <i class="fas fa-user-md"></i>
                </div>
                <h3>{{ msg["vet.noVeterinarians"]|e }}</h3>
                <p>{{ msg["vet.noVeterinariansMessage"]|e }}</p>
            </div>
        {% else %}
            <div class="row g-4">
                {% for vet in vets %}
                    <div class="col-md-6 col-lg-4">
                        <div class="vet-card animate-fade-in-up">
                            <div class="vet-card-header">
                                <div class="vet-avatar">
                                    <i class="fas fa-user-md"></i>
                                </div>
                            </div>
                            <div class="vet-card-body">
                                <h5>{{ vet.firstName|e }} {{ vet.lastName|e }}</h5>

                                {% if not vet.specialities.isEmpty %}
                                    <div class="mt-3">
                                        {% for s in vet.specialities %}
                                            <span class="speciality-badge">{{ s.name|e }}</span>
                                        {% endfor %}
                                    </div>
                                {% else %}
                                    <div class="mt-3">
                                        <span class="speciality-badge">{{ msg["vet.generalPractice"]|e }}</span>
                                    </div>
                                {% endif %}

                                <div class="mt-4 pt-3 border-top">
                                    <div class="d-flex justify-content-center gap-3">
                                        <span class="text-muted small">
                                            <i class="fas fa-certificate text-warning me-1"></i>{{ msg["vet.licensed"]|e }}
                                        </span>
                                        <span class="text-muted small">
                                            <i class="fas fa-star text-warning me-1"></i>{{ msg["vet.topRated"]|e }}
                                        </span>
                                    </div>
                                    <div class="mt-3">
                                        <a class="btn btn-sm btn-outline-primary" href="/vets/{{ vet.id|e }}/edit">
                                            <i class="fas fa-pen me-1"></i>{{ msg["vet.edit"]|e }}
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </main>
{% endblock %}
