{% extends "_layout.jinja" %}
{% block content %}

    <div class="page-header">
        <div class="container">
            <h1>{{ msg["error.title"]|e }}</h1>
            <p>{{ msg["error.subtitle"]|e }}</p>
        </div>
    </div>

    <main class="container flex-grow-1 py-4">
        <div class="card">
            <div class="card-body">
                <h5 class="mb-3">{{ msg["error.details"]|e }}</h5>
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="text-muted small">{{ msg["error.requestedPath"]|e }}</div>
                        <div><code>{{ path|e }}</code></div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-muted small">{{ msg["error.exception"]|e }}</div>
                        <div><code>{{ exception|e }}</code></div>
                    </div>
                    <div class="col-md-12">
                        <div class="text-muted small">{{ msg["error.message"]|e }}</div>
                        <div><code>{{ message|default("", true)|e }}</code></div>
                    </div>
                </div>

                <div class="mt-4 d-flex gap-2 flex-wrap">
                    <a class="btn btn-primary" href="/">{{ msg["button.home"]|e }}</a>
                    <a class="btn btn-outline-secondary" href="/owners/find">{{ msg["owner.findOwners"]|e }}</a>
                </div>
            </div>
        </div>
    </main>

{% endblock %}
